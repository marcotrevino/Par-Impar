
#include <stdio.h>
int main(){
    
    int contador,numero;
    printf("\t\t Programa para determinar si un número es par o impar\n");
    printf("\t\t                Se pediran 10 números\n\n");
    
    // Mediante el uso de un ciclo "for" se van pidiendo los números y posteriormente
    // se verifica si el residuo del número al dividirlo entre 2 es cero, se despliega
    // el mensaje de si es impar o par.
    
    for (contador=1; contador <=10; contador++){
        
        printf("Dame un número entero (%d de 10):",contador);
        scanf("%d", &numero);
        if (numero % 2 == 0){
            printf("El número %d es par \n",numero);
            }else {printf("El número %d es impar \n",numero) ;       }
    }
     
    return 0;
    
}
